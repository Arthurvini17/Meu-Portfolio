# Copie para .env.local e preencha com suas chaves.
# .env.local e' ignorado pelo git — nunca commite chaves reais.
# Em producao (EasyPanel), estas variaveis vao na aba Environment do servico.

# OpenAI — usada pelo chat (/api/chat). Lida automaticamente pelo @ai-sdk/openai.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Resend — envio do resumo da conversa por email (/api/chat/summary).
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinatario do resumo da conversa.
EMAIL_TO=seu@email.com

# URL publica do site. Usada no metadataBase (og:image, og:url, canonical).
# Em dev pode deixar em branco — o fallback e' http://localhost:3000.
# Em producao E' OBRIGATORIA, senao o preview de link aponta pra localhost.
NEXT_PUBLIC_SITE_URL=https://seudominio.com
